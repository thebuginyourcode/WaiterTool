<Window x:Class="WaiterTool.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:WaiterTool.Converters"
        Title="Waiter Tool" Height="760" Width="1240"
        WindowStartupLocation="CenterScreen"
        Background="#F2F2F2">
    <Window.Resources>
        <conv:PathToImageConverter x:Key="PathToImageConverter" />
    </Window.Resources>

    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="320" />
        </Grid.ColumnDefinitions>

        <!-- Left: waiter list management -->
        <Border Grid.Column="0" Background="White" CornerRadius="8" Padding="16" Margin="0,0,12,0">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Waiters" FontSize="20" FontWeight="Bold" Margin="0,0,0,12" />

                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,12">
                    <TextBox x:Name="NewWaiterTextBox" Width="170" Padding="6" FontSize="14"
                             KeyDown="NewWaiterTextBox_KeyDown" />
                    <Button Content="Add" Width="60" Margin="8,0,0,0" Padding="0,6" Click="AddWaiter_Click" />
                </StackPanel>

                <Button DockPanel.Dock="Bottom" Content="Remove Selected" Margin="0,12,0,0" Padding="0,8"
                        Click="RemoveWaiter_Click" />

                <ListBox x:Name="QueueListBox" ItemsSource="{Binding Queue}" DisplayMemberPath="Name" FontSize="15" />
            </DockPanel>
        </Border>

        <!-- Center: current turn + last capture -->
        <Grid Grid.Column="1" Margin="0,0,12,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="White" CornerRadius="8" Padding="24" Margin="0,0,0,12">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="CURRENT TURN" FontSize="14" Foreground="#999" HorizontalAlignment="Center"
                               FontWeight="Bold" />
                    <TextBlock x:Name="CurrentWaiterText" Text="—" FontSize="44" FontWeight="Bold"
                               HorizontalAlignment="Center" Margin="0,4,0,16" />
                    <Button x:Name="NextWaiterButton" Content="Next Waiter" FontSize="20" Padding="28,12"
                            Click="NextWaiter_Click" IsEnabled="False" />
                </StackPanel>
            </Border>

            <Border Grid.Row="1" Background="White" CornerRadius="8" Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Last Capture" FontSize="16" FontWeight="Bold" Margin="0,0,0,12" />

                    <Grid Grid.Row="1">
                        <TextBlock x:Name="NoCaptureText" Text="No photo captured yet" HorizontalAlignment="Center"
                                   VerticalAlignment="Center" Foreground="#AAA" FontSize="16" />

                        <StackPanel x:Name="LastCapturePanel" Visibility="Collapsed" VerticalAlignment="Center">
                            <Border BorderBrush="#DDD" BorderThickness="1" CornerRadius="6"
                                    HorizontalAlignment="Center">
                                <Image x:Name="LastCaptureImage" MaxHeight="360" MaxWidth="480" Stretch="Uniform" />
                            </Border>
                            <TextBlock x:Name="LastCaptureInfoText" HorizontalAlignment="Center" Margin="0,12,0,0"
                                       FontSize="16" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- Right: history -->
        <Border Grid.Column="2" Background="White" CornerRadius="8" Padding="16">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="History" FontSize="20" FontWeight="Bold" Margin="0,0,0,12" />

                <ListBox x:Name="HistoryListBox" ItemsSource="{Binding History}" BorderThickness="0">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="48" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Width="44" Height="44" CornerRadius="4" ClipToBounds="True"
                                        Background="#EEE">
                                    <Image Source="{Binding PhotoPath, Converter={StaticResource PathToImageConverter}}"
                                           Stretch="UniformToFill" />
                                </Border>

                                <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                    <TextBlock Text="{Binding WaiterName}" FontWeight="Bold" FontSize="14" />
                                    <TextBlock Text="{Binding TableNumber, StringFormat='Table {0}'}" FontSize="12"
                                               Foreground="#666" />
                                    <TextBlock Text="{Binding Timestamp, StringFormat='{}{0:g}'}" FontSize="11"
                                               Foreground="#999" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>
    </Grid>
</Window>
