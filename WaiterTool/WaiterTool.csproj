<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>WaiterTool</RootNamespace>
    <AssemblyName>WaiterTool</AssemblyName>
    <!-- Without this, WPF's native renderer DLLs (PresentationNative_*.dll, wpfgfx_*.dll, etc.)
         and OpenCvSharp's native DLLs are left as loose files next to the single-file exe
         instead of being bundled into it, so the exe fails to start if those files aren't
         shipped alongside it. -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <!-- Precompiles to native code at publish time instead of JIT-compiling on every cold
         start, which is the main lever for faster launch on a self-contained app. -->
    <PublishReadyToRun>true</PublishReadyToRun>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="OpenCvSharp4" Version="4.10.0.20240616" />
    <PackageReference Include="OpenCvSharp4.runtime.win" Version="4.10.0.20240616" />
    <PackageReference Include="OpenCvSharp4.WpfExtensions" Version="4.10.0.20240616" />
    <!-- Pin explicitly: OpenCvSharp4.WpfExtensions references a newer System.Drawing.Common
         than OpenCvSharp4 does, which NuGet doesn't auto-unify for a compile-time reference. -->
    <PackageReference Include="System.Drawing.Common" Version="8.0.0" />
  </ItemGroup>

</Project>
