<?xml version="1.0" encoding="UTF-8" ?>
<Shell xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:local="clr-namespace:WaiterTool.Mobile"
       x:Class="WaiterTool.Mobile.AppShell"
       Shell.FlyoutBehavior="Disabled"
       Shell.NavBarIsVisible="False">
    <TabBar>
        <ShellContent Title="Current" ContentTemplate="{DataTemplate local:CurrentTurnPage}" Route="CurrentTurnPage" />
        <ShellContent Title="Waiters" ContentTemplate="{DataTemplate local:WaitersPage}" Route="WaitersPage" />
        <ShellContent Title="History" ContentTemplate="{DataTemplate local:HistoryPage}" Route="HistoryPage" />
    </TabBar>
</Shell>
