<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="WaiterTool.Mobile.SkipCapturePage"
             Title="Skip Turn"
             BackgroundColor="{StaticResource PageBackgroundColor}">

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="20" HorizontalOptions="Center" MaximumWidthRequest="480">

            <Border WidthRequest="260" HeightRequest="340" StrokeShape="RoundRectangle 12" Stroke="#DDDDDD"
                    BackgroundColor="Black" HorizontalOptions="Center">
                <Grid>
                    <toolkit:CameraView x:Name="CameraPreview" />
                    <Image x:Name="CapturedPhotoImage" Aspect="AspectFill" IsVisible="False" />
                </Grid>
            </Border>

            <Label x:Name="HeaderLabel" FontSize="26" FontAttributes="Bold" HorizontalOptions="Center"
                   HorizontalTextAlignment="Center" TextColor="{StaticResource PrimaryTextColor}" />

            <Button x:Name="CaptureButton" Text="Capture Photo" Clicked="OnCaptureClicked"
                    HorizontalOptions="Center" />

            <HorizontalStackLayout Spacing="12" HorizontalOptions="Center">
                <Button Text="Cancel" Clicked="OnCancelClicked" TextColor="#6B7280" BorderColor="#6B7280" />
                <Button x:Name="ConfirmSkipButton" Text="Confirm Skip" Clicked="OnConfirmClicked"
                        TextColor="#D97706" BorderColor="#D97706" />
            </HorizontalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
