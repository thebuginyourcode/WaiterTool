<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:WaiterTool.Mobile.Models"
             x:Class="WaiterTool.Mobile.WaitersPage"
             Title="Waiters"
             BackgroundColor="{StaticResource PageBackgroundColor}">

    <Grid Padding="20" RowDefinitions="Auto,Auto,*,Auto" RowSpacing="14"
          MaximumWidthRequest="{OnIdiom Phone=100000, Tablet=700, Default=700}" HorizontalOptions="Center">

        <Label Text="Waiters" FontSize="26" FontAttributes="Bold" TextColor="{StaticResource PrimaryTextColor}" />

        <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="10">
            <Entry x:Name="NewWaiterEntry" Grid.Column="0" Placeholder="Waiter name"
                   Completed="OnAddWaiterClicked" />
            <Button Grid.Column="1" Text="Add" Clicked="OnAddWaiterClicked" />
        </Grid>

        <CollectionView Grid.Row="2" x:Name="QueueCollectionView" SelectionMode="Single">
            <CollectionView.EmptyView>
                <Label Text="No waiters yet. Add one above." TextColor="{StaticResource MutedTextColor}"
                       HorizontalOptions="Center" VerticalOptions="Center" FontSize="16" />
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:Waiter">
                    <Grid Padding="14,14">
                        <Label Text="{Binding Name}" FontSize="18" TextColor="{StaticResource PrimaryTextColor}" />
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Button Grid.Row="3" Text="Remove Selected" Clicked="OnRemoveWaiterClicked"
                TextColor="#DC2626" BorderColor="#DC2626" />
    </Grid>
</ContentPage>
